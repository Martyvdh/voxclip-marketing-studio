# Copy to .env and fill in. Never commit .env.

# Postgres. Neon in production, local Postgres in development.
DATABASE_URL="postgresql://user:password@localhost:5432/voxclip_studio?schema=public"

# 32+ random bytes, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public base URL of this Studio. Used for absolute links and cookie scope.
APP_URL="http://localhost:3000"

# Base URL of the public VoxClip website. Used for tagged campaign links.
PUBLIC_SITE_URL="https://voxclip.it"

# Safety switch. Leave false everywhere except a deliberate production publish.
# When false, every provider adapter is a fake that records the payload and posts nothing.
ENABLE_REAL_PUBLISHING="false"

# Seed account for first login. The seed generates a password and prints it once.
SEED_ADMIN_EMAIL="martijnmawebdesign@gmail.com"
