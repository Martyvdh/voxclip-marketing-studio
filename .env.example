# Copy to .env and fill in. Never commit .env.

# Supabase Postgres, session pooler (IPv4, port 5432).
# Use this for migrations, the seed, and local development.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# On Vercel, use the transaction pooler instead (port 6543). Every request there
# is a short-lived serverless invocation, which is what that pooler is for.
DATABASE_URL=""

# 32+ random bytes, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public base URL of this Studio. Used for absolute links and cookie scope.
APP_URL="http://localhost:3000"

# Base URL of the public VoxClip website. Used for tagged campaign links.
PUBLIC_SITE_URL="https://voxclip.it"

# Safety switch. Leave false everywhere except a deliberate production publish.
# When false, every provider adapter is a fake that records the payload and posts nothing.
ENABLE_REAL_PUBLISHING="false"

# Seed account for first login. The seed generates a password and prints it once.
SEED_ADMIN_EMAIL=""
